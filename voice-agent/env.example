# ── Daily (WebRTC transport) ──────────────────────────────────────────────
DAILY_API_KEY=

# ── AssemblyAI (STT) ───────────────────────────────────────────────────────
ASSEMBLYAI_API_KEY=


# ── Groq (LLM) ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_

# ── Cartesia (TTS, primary) ────────────────────────────────────────────────
CARTESIA_API_KEY=
# Optional: override the default voice
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# ── Deepgram (TTS, automatic failover if Cartesia errors) ────────────────
DEEPGRAM_API_KEY=
# Optional: override the default voice
# DEEPGRAM_VOICE=aura-2-helena-en

# ── BK Menu MCP server (from the bk-menu-db project) ──────────────────────
# Local dev (docker compose up in ../bk-menu-db):
MCP_SERVER_URL=http://localhost:8080/sse
# Once bk-menu-db is deployed publicly, point this at that URL instead, e.g.:
# MCP_SERVER_URL=https://your-mcp-host.example.com/sse

#
REDIS-AGENT-MEMORY=
LANGCACHE_SERVER_URL=https://aws-us-east-1.langcache.redis.io
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=


LANGCACHE_TTL_MILLIS=21600000


# Local dev (docker compose up in ../memory-mcp):

MEMORY_MCP_URL=http://localhost:8081/sse
# Optional: how long a cached menu lookup stays valid, in milliseconds.
# Default is 6 hours (menu data rarely changes).

# ── Customer Memory MCP server (from the memory-mcp project) ─────────────
# Long-term, cross-visit customer memory (opt-in, phone-number keyed).
# If left blank, the bot still works — it just won't remember customers
# across visits.


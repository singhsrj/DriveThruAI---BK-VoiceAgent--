# LiveKit server connection — self-hosted via Docker (see README.md).
# The --dev flag on livekit-server uses this fixed devkey/secret pair.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Voice pipeline providers — same keys you used with the Pipecat version.
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=

# Optional overrides
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
# DEEPGRAM_VOICE=aura-2-helena-en

# MCP server (bk-menu-mcp/server.py). Must end in /mcp — that's how
# LiveKit's MCP client knows to use streamable HTTP instead of SSE.
# Port 8943 matches server.py's current hardcoded default.
MCP_SERVER_URL=http://127.0.0.1:8943/mcp
